{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webitor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "SHARES",
      "bucket_name": "webitor-shares"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PICKUP_CODES",
        "class_name": "PickupCode"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PickupCode"]
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PICKUP_IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PICKUP_CODE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "SHARE_TTL_SECONDS": "604800",
    "PICKUP_TTL_SECONDS": "600"
  },
  "observability": {
    "enabled": true
  }
}
